  <diagram id="03-component-workspace" name="Web SPA - Collaboration Workspace Feature - Component Diagram (C4 Level 3)">
    <mxGraphModel dx="1800" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1560" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Web SPA - Collaboration Workspace Feature - Component Diagram (C4 Level 3)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="b_mod" value="&lt;b style=&quot;font-size:14px&quot;&gt;Workspace feature&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[pages/Workspace, components/Workspace, services/Workspace, store, hooks, queryKeys]&lt;/span&gt;" style="rounded=1;arcSize=1;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 5;fillColor=none;strokeColor=#444444;strokeWidth=1.5;fontColor=#444444;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=4;container=0;" vertex="1" parent="1"><mxGeometry x="160" y="70" width="1600" height="920" as="geometry"/></mxCell>
        <mxCell id="b_core" value="&lt;b style=&quot;font-size:14px&quot;&gt;Shared infrastructure (used by every feature)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[src/services, src/store]&lt;/span&gt;" style="rounded=1;arcSize=1;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 5;fillColor=none;strokeColor=#444444;strokeWidth=1.5;fontColor=#444444;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=4;container=0;" vertex="1" parent="1"><mxGeometry x="160" y="1050" width="1600" height="220" as="geometry"/></mxCell>
        <mxCell id="page" value="&lt;b style=&quot;font-size:14px&quot;&gt;WorkspacePage&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Page: src/pages/Workspace/WorkspacePage.tsx]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Route /dashboard/workspace/:projectId. Loads the project and renders the tabbed layout (shadcn Tabs).&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="995" y="95" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="perm" value="&lt;b style=&quot;font-size:14px&quot;&gt;useWorkspacePermissions&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Hook: src/hooks/useWorkspacePermissions.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Derives allowed actions from the role in userStore and the project status. UX only - the server is authoritative.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1440" y="95" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="store" value="&lt;b style=&quot;font-size:14px&quot;&gt;workspaceStore&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Zustand: src/store/workspaceStore]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Active tab, persisted message drafts, unread counters, typing users, socket status.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="200" y="320" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="chat" value="&lt;b style=&quot;font-size:14px&quot;&gt;ChatPanel&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[React: components/Workspace]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Messages, attachments, unread badge, typing &amp;amp; read receipts.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="deliv" value="&lt;b style=&quot;font-size:14px&quot;&gt;DeliverablesPanel&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[React: components/Workspace]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Submit outputs (Formik + Yup), request revisions, accept delivery.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="860" y="320" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="tasks" value="&lt;b style=&quot;font-size:14px&quot;&gt;TaskBoard&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[React: components/Workspace]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tasks, milestones, deadlines and activity timeline.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="320" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="agree" value="&lt;b style=&quot;font-size:14px&quot;&gt;AgreementPanel&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[React: components/Workspace]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Current agreement version, change requests, pause / cancel actions.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1460" y="320" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="rt" value="&lt;b style=&quot;font-size:14px&quot;&gt;useWorkspaceSocket&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Hook: src/hooks/useWorkspaceSocket.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Subscribes to project events and maps them to query-cache and store updates.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="200" y="555" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="hooks" value="&lt;b style=&quot;font-size:14px&quot;&gt;Workspace queries &amp;amp; mutations&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[TanStack Query: useQuery / useMutation + src/queryKeys/workspace.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Messages (infinite), tasks, deliverables, agreement. Mutations invalidate keys, show sonner toasts and translate errors with translateAxiosError.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="555" width="1150" height="130" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b style=&quot;font-size:14px&quot;&gt;Workspace services&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[TS: src/services/Workspace/*Service.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;getMessagesService, sendMessageService, submitDeliverableService ... built on getData / postData.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="605" y="800" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="upload" value="&lt;b style=&quot;font-size:14px&quot;&gt;uploadFileService&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[TS: src/services/Workspace/uploadFileService.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Gets a pre-signed URL, then PUTs the file to MinIO with progress and size/type checks.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1120" y="800" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="socket" value="&lt;b style=&quot;font-size:14px&quot;&gt;socketClient&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[TS: src/services/socket.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Single shared WebSocket, token handshake, reconnect with backoff, channel subscriptions.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="200" y="1090" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="http" value="&lt;b style=&quot;font-size:14px&quot;&gt;apiClient + request helpers&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Axios: src/services/services.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;getData / postData / patchData / deleteData. Adds Bearer token from userStore; refreshes it on 401.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="605" y="1090" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="backend" value="&lt;b style=&quot;font-size:14px&quot;&gt;Backend API&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: Go, Gin]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;REST/JSON /api/v1 and WebSocket hub /ws.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="200" y="1380" width="685" height="140" as="geometry"/></mxCell>
