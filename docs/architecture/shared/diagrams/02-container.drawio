<mxfile host="app.diagrams.net" type="device">
  <diagram id="02-container" name="Zedlancer - Container Diagram (C4 Level 2)">
    <mxGraphModel dx="1680" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1260" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Zedlancer - Container Diagram (C4 Level 2)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="b_sys" value="&lt;b style=&quot;font-size:14px&quot;&gt;Zedlancer Platform&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System - Modular Monolith]&lt;/span&gt;" style="rounded=1;arcSize=1;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 5;fillColor=none;strokeColor=#444444;strokeWidth=1.5;fontColor=#444444;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=4;container=0;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="1120" height="930" as="geometry"/></mxCell>
        <mxCell id="applicant" value="&lt;b style=&quot;font-size:14px&quot;&gt;Applicant (15-22)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Builds profile, applies, collaborates.&lt;/span&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="85" y="70" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="parent" value="&lt;b style=&quot;font-size:14px&quot;&gt;Parent / Guardian&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Links teen account, gives consent.&lt;/span&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="445" y="70" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="employer" value="&lt;b style=&quot;font-size:14px&quot;&gt;Employer&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Posts opportunities, reviews work.&lt;/span&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="805" y="70" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="admin" value="&lt;b style=&quot;font-size:14px&quot;&gt;Platform Admin&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Verification, moderation &amp;amp; disputes.&lt;/span&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1165" y="70" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b style=&quot;font-size:14px&quot;&gt;Frontend Web Server&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: Docker, Node 20 + serve]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Serves the static Vite build (dist/) on port 3000. Frontend repo.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="280" height="160" as="geometry"/></mxCell>
        <mxCell id="spa" value="&lt;b style=&quot;font-size:14px&quot;&gt;Web Application (SPA)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: React 19, TypeScript, Vite, Tailwind CSS v4, shadcn/ui, Zustand, TanStack Query]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Role-based RTL Persian UI for applicants, parents, employers and admins. Runs in the browser.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="540" y="390" width="400" height="180" as="geometry"/></mxCell>
        <mxCell id="storage" value="&lt;b style=&quot;font-size:14px&quot;&gt;File Storage&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: MinIO, S3-compatible]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Profile images, chat attachments, deliverables and identity documents (private bucket).&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="100" y="740" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b style=&quot;font-size:14px&quot;&gt;Backend API&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: Go, Gin - modular monolith]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;REST/JSON (/api/v1) + WebSocket hub (/ws), OpenAPI docs. Enforces roles, consent and access on every request. Backend repo.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="540" y="740" width="400" height="180" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b style=&quot;font-size:14px&quot;&gt;Database&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: PostgreSQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Users, opportunities, agreements, messages, simulated transactions, audit log.&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="590" y="1000" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="sms" value="&lt;b style=&quot;font-size:14px&quot;&gt;SMS Provider&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[External System]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;OTP codes and important notifications.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1300" y="600" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="kyc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Identity Inquiry Provider&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[External System - KYC, mocked in academic version]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;National code, mobile ownership and civil-registry checks.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1300" y="900" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="e0" value="&lt;b&gt;Uses&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="applicant" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;Uses&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="parent" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;Uses&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="employer" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="&lt;b&gt;Uses&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="admin" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="&lt;b&gt;Delivers SPA&lt;/b&gt;&lt;br&gt;bundle&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="web" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="&lt;b&gt;API calls &amp;amp; live events&lt;/b&gt;&lt;br&gt;&lt;i&gt;[REST/JSON over HTTPS,&lt;/i&gt;&lt;br&gt;WebSocket over WSS]" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="spa" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="&lt;b&gt;Uploads / downloads files&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS, pre-signed URLs]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="spa" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="&lt;b&gt;Stores &amp;amp; signs&lt;/b&gt;&lt;br&gt;files&lt;br&gt;&lt;i&gt;[S3 API]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="&lt;b&gt;Reads / writes&lt;/b&gt;&lt;br&gt;&lt;i&gt;[SQL / TCP]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="&lt;b&gt;Sends SMS&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS API]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="sms"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="&lt;b&gt;Inquires identity&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS API]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="kyc"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
