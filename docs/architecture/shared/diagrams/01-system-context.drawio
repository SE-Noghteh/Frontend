<mxfile host="app.diagrams.net" type="device">
  <diagram id="01-system-context" name="Zedlancer - System Context Diagram (C4 Level 1)">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Zedlancer - System Context Diagram (C4 Level 1)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="parent" value="&lt;b style=&quot;font-size:14px&quot;&gt;Parent / Guardian&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Links to a teen account (15-17), approves or withdraws consent and monitors activity.&lt;/span&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="admin" value="&lt;b style=&quot;font-size:14px&quot;&gt;Platform Admin&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Verifies user documents, moderates opportunities, handles safety reports and resolves disputes.&lt;/span&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="910" y="80" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="applicant" value="&lt;b style=&quot;font-size:14px&quot;&gt;Applicant (15-22)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Teen or young adult who builds a skill passport, applies for opportunities and delivers work.&lt;/span&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="employer" value="&lt;b style=&quot;font-size:14px&quot;&gt;Employer&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Business or individual that posts opportunities, selects applicants and reviews deliverables.&lt;/span&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1120" y="430" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="zed" value="&lt;b style=&quot;font-size:14px&quot;&gt;Zedlancer Platform&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Web platform that manages the full collaboration cycle: posting, applying, parental consent, agreement, delivery, evaluation and skill history.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="400" height="190" as="geometry"/></mxCell>
        <mxCell id="sms" value="&lt;b style=&quot;font-size:14px&quot;&gt;SMS Provider&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[External System]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Delivers OTP / verification codes and important notifications by SMS.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="800" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="kyc" value="&lt;b style=&quot;font-size:14px&quot;&gt;Identity Inquiry Provider&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[External System - KYC, mocked in academic version]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Checks national code, mobile ownership and civil-registry data.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="800" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="e0" value="&lt;b&gt;Searches &amp;amp; applies,&lt;/b&gt;&lt;br&gt;collaborates, delivers&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="applicant" target="zed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;Links account,&lt;/b&gt;&lt;br&gt;gives consent&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="parent" target="zed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;Posts opportunities,&lt;/b&gt;&lt;br&gt;reviews deliverables&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="employer" target="zed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="&lt;b&gt;Verifies documents,&lt;/b&gt;&lt;br&gt;moderates&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="admin" target="zed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="&lt;b&gt;Sends OTP codes &amp;amp;&lt;/b&gt;&lt;br&gt;notifications&lt;br&gt;&lt;i&gt;[HTTPS API]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zed" target="sms"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="&lt;b&gt;Inquires identity&lt;/b&gt;&lt;br&gt;data&lt;br&gt;&lt;i&gt;[HTTPS API]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zed" target="kyc"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
