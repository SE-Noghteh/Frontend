<mxfile host="app.diagrams.net" type="device">
  <diagram id="04-deployment" name="Zedlancer - Deployment Diagram (CI/CD and Production)">
    <mxGraphModel dx="1700" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1090" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Zedlancer - Deployment Diagram (CI/CD and Production)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="b_srv" value="&lt;b style=&quot;font-size:14px&quot;&gt;Production Server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Linux, Docker Engine - shared Docker network: web]&lt;/span&gt;" style="rounded=1;arcSize=1;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 5;fillColor=none;strokeColor=#444444;strokeWidth=1.5;fontColor=#444444;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=4;container=0;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="1220" height="680" as="geometry"/></mxCell>
        <mxCell id="gh" value="&lt;b style=&quot;font-size:14px&quot;&gt;GitHub Repositories&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Frontend repo, Backend repo]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Feature branches merged into develop via pull requests.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="actions" value="&lt;b style=&quot;font-size:14px&quot;&gt;GitHub Actions - CD&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Workflow per repo: CD.yml]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;On push to develop: docker compose build, push image, deploy over SSH.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e3ecf7;strokeColor=#6b8db5;fontColor=#1a1a1a;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="90" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="ghcr" value="&lt;b style=&quot;font-size:14px&quot;&gt;GitHub Container Registry&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[ghcr.io]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Stores frontend and backend Docker images.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="tg" value="&lt;b style=&quot;font-size:14px&quot;&gt;Telegram Bot&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Team group]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Receives build success / failure and deploy reports.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="users" value="&lt;b style=&quot;font-size:14px&quot;&gt;Users&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Person - browser]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Applicants, parents, employers, admins.&lt;/span&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="cf" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cloudflare&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[DNS, TLS, Tunnel]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Public domains and the SSH tunnel used by CI.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="compose" value="&lt;b style=&quot;font-size:14px&quot;&gt;docker compose&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Deployment tool]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Pulls the latest images and (re)starts the containers from docker-compose.yml.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e3ecf7;strokeColor=#6b8db5;fontColor=#1a1a1a;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="proxy" value="&lt;b style=&quot;font-size:14px&quot;&gt;Reverse Proxy (TBD)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: to be decided]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Routes the main domain to the frontend and api. domain + /ws to the backend.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#438dd5;fontColor=#1a1a1a;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="590" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="fe" value="&lt;b style=&quot;font-size:14px&quot;&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: node:20-alpine + serve :3000]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Image: ghcr.io/&amp;lt;org&amp;gt;/frontend&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="be" value="&lt;b style=&quot;font-size:14px&quot;&gt;backend&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: Go / Gin binary]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Image: ghcr.io/&amp;lt;org&amp;gt;/backend&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="pg" value="&lt;b style=&quot;font-size:14px&quot;&gt;postgres&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: PostgreSQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Persistent volume.&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1300" y="560" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="minio" value="&lt;b style=&quot;font-size:14px&quot;&gt;minio&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Container: MinIO]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Persistent volume for files.&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1300" y="800" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="e0" value="&lt;b&gt;Push to develop&lt;/b&gt;&lt;br&gt;triggers CD" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gh" target="actions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;Builds &amp;amp; pushes&lt;/b&gt;&lt;br&gt;images" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="actions" target="ghcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;Build / deploy&lt;/b&gt;&lt;br&gt;reports" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="actions" target="tg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="&lt;b&gt;Deploys over SSH&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Cloudflare Tunnel]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="actions" target="compose"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="&lt;b&gt;Pulls images&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="compose" target="ghcr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="&lt;b&gt;HTTPS&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="users" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="&lt;b&gt;Forwards&lt;/b&gt;&lt;br&gt;requests" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cf" target="proxy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="&lt;b&gt;main domain&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTP :3000]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="proxy" target="fe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="&lt;b&gt;api. domain, /ws&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTP / WS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="proxy" target="be"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="&lt;b&gt;SQL&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="be" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="&lt;b&gt;S3 API&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="be" target="minio"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
